# Copy this file to .env.local and fill in the values.
# For local dev these must match the keys block in livekit.yaml.

# Server-side only — NEVER expose the secret to the browser.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_to_at_least_32_chars

# Server-side LiveKit URL (admin/token context).
LIVEKIT_URL=ws://localhost:7880

# Browser-facing LiveKit websocket URL (what the client connects to).
# Locally this is the same as LIVEKIT_URL. In production use your wss:// URL.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# --- Accounts (Supabase) — needed once sign-up/login is added ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY — keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Pro subscriptions (Stripe) — needed for the paid tier ---
# From your Stripe dashboard. See STRIPE-SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Public site URL, used for Stripe redirect URLs and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
